config BENCH_TFLM
	bool "Run the model on the CPU with TensorFlow Lite Micro instead of the Axon NPU"

config BENCH_TFLM_ARENA_SIZE
	int "TFLM tensor arena, bytes"
	default 131072

config BENCH_TOLERANCE
	int "Largest accepted difference with the expected output, per int8 value"
	default 2

config BENCH_GAP_MS
	int "Sleep between two inferences, ms; 0 keeps the CPU awake for 100 µs instead"
	default 50

source "Kconfig.zephyr"
